{
  "name": "adamwebfix",
  "version": "1.0.0",
  "type": "module",
  "description": "Adam web fix",
  "main": "server.js",
  "scripts": {
    "watch": "node --watch server.js ",
    "test": "echo \"Error: no test specified\" && exit 1",
